@model List<Producto>
@{
    ViewData["Title"] = "Productos";
}
<div class="encabezado">
    <div>
        <h1>Gestión de productos</h1>
        <p>Lista de productos de la tienda tecnológica.</p>
    </div>
    <a class="boton" asp-action="Create">+ Nuevo producto</a>
</div>
@if (TempData["Mensaje"] is string mensaje)
{
    <p class="mensaje">@mensaje</p>
}
<div class="tabla">
    <table>
        <thead>
            <tr>
                <th>ID</th><th>SKU</th><th>Nombre</th><th>Categoría</th>
                <th>Precio (Bs)</th><th>Stock</th><th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model)
            {
                <tr>
                    <td>@producto.Id</td>
                    <td>@producto.Sku</td>
                    <td>@producto.Nombre</td>
                    <td>@producto.CategoriaNombre</td>
                    <td>@producto.Precio.ToString("N2")</td>
                    <td>@producto.Stock</td>
                    <td class="acciones">
                        <a asp-action="Edit" asp-route-id="@producto.Id">Editar</a>
                        <a asp-action="Delete" asp-route-id="@producto.Id" class="peligro">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Count == 0)
    {
        <p class="vacio">Todavía no hay productos registrados.</p>
    }
</div>
