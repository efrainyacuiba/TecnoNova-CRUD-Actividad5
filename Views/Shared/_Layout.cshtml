<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - TecnoNova Bolivia</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="contenedor cabecera">
            <a asp-controller="Productos" asp-action="Index" class="logo">TecnoNova Bolivia</a>
            <span>CRUD de productos · Actividad 5</span>
        </nav>
    </header>
    <main class="contenedor">
        @RenderBody()
    </main>
    <footer class="contenedor">Prototipo académico en C# MVC + PostgreSQL</footer>
</body>
</html>
